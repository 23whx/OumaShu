---
// 內頁頂欄：品牌、站內搜索（提交到本語言首頁）、語言選單
import LangMenu from './LangMenu.astro';
import { dict, localePath, type Locale } from '../i18n/routes';
import { UI } from '../i18n/ui';

export interface Props {
  locale: Locale;
  /** 語言無關的當前路徑，給語言選單用 */
  path: string;
}
const { locale, path } = Astro.props;
const t = dict(locale);
const home = localePath(locale, '/');
---

<header class="cbar">
  <div class="cbar__inner">
    <a class="brand" href={home}>
      <span class="seal" aria-hidden="true" lang="ja">櫻</span>
      <span class="brand__name">OumaShu<span class="brand__ja" lang="ja">櫻滿集</span></span>
    </a>
    <form class="csearch" action={home} method="get" role="search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
      <label class="sr-only" for="csearch-q">{UI[locale].searchAll}</label>
      <input id="csearch-q" name="q" type="search" placeholder={t.search_placeholder} autocomplete="off" />
    </form>
    <LangMenu locale={locale} path={path} />
  </div>
</header>

<style>
  .cbar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.72);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--hairline);
  }
  :global([data-theme='dark']) .cbar {
    background: rgba(12, 12, 13, 0.7);
  }
  .cbar__inner {
    max-width: 1320px;
    height: 64px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .csearch {
    position: relative;
    flex: 1;
    max-width: 420px;
    margin-left: auto;
  }
  .cbar__inner > :global(.lang) {
    margin-right: -9px;
  }
  .csearch svg {
    position: absolute;
    left: 12px;
    top: 50%;
    width: 17px;
    height: 17px;
    transform: translateY(-50%);
    color: var(--color-muted);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    pointer-events: none;
  }
  .csearch input {
    width: 100%;
    height: 38px;
    padding: 0 14px 0 38px;
    border: 1px solid var(--hairline);
    border-radius: 10px;
    background: var(--wash);
    color: var(--color-fg);
    font: 500 15px/1 var(--font-sans);
    outline: none;
  }
  .csearch input:focus {
    background: var(--color-card);
    border-color: var(--shu);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--shu) 22%, transparent);
  }

  @media (max-width: 760px) {
    .cbar {
      position: static;
    }
    .cbar__inner {
      height: auto;
      padding: 12px 16px;
      flex-wrap: wrap;
      gap: 10px;
    }
    .cbar__inner > :global(.lang) {
      margin-left: auto;
    }
    .csearch {
      order: 3;
      flex-basis: 100%;
      max-width: none;
      margin-left: 0;
    }
  }
</style>

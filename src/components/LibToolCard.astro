---
// 圖書館書架上的一張工具卡：排名、名稱、推薦理由、事實標籤、核查日期、打開連結
// compact：書架後段用的精簡列，只留名稱、一句話介紹、關鍵標籤和打開連結
import { libCopy, libNote, libTool, libToolName, libToolUrl, onGitHub } from '../data/library';
import { hostOf } from '../data/lines';
import { formatDate } from '../data/stats';
import { fill, type Locale } from '../i18n/routes';

export interface Props {
  locale: Locale;
  shelfId: string;
  toolId: string;
  rank: number;
  tested?: boolean;
  compact?: boolean;
}

const { locale, shelfId, toolId, rank, tested = false, compact = false } = Astro.props;
const c = libCopy(locale);
const tool = libTool(toolId);
const name = libToolName(toolId, locale);
const href = libToolUrl(toolId, locale);
const note = libNote(locale, shelfId, toolId);
const textDir = locale === 'ar' ? 'rtl' : undefined;
const checkedText = fill(tested ? c.ui.tested : c.ui.checked, { date: formatDate(tool.checked, locale) });

// 事實標籤：好的一面用 ok，需要留意的用 warn，中性的用 info
type Chip = { text: string; kind: 'ok' | 'warn' | 'info' };
const chips: Chip[] = [
  { text: c.ui.price[tool.price], kind: tool.price === 'free' ? 'ok' : 'info' },
  { text: c.ui.noSignup, kind: 'ok' },
  { text: c.ui.runs[tool.runs], kind: tool.runs === 'cloud' ? 'warn' : tool.runs === 'local' ? 'ok' : 'info' },
];
if (tool.openSource) chips.push({ text: c.ui.openSource, kind: 'ok' });
if (tool.signupForm) chips.push({ text: c.ui.signupForm, kind: 'warn' });
if (tool.ads) chips.push({ text: c.ui.ads, kind: 'warn' });
const github = onGitHub(tool);
const kindTag = tool.kind ? c.ui[tool.kind] : null;
// 精簡列只留最能幫人做決定的標籤：免費程度、檔案去向／類型、廣告
const compactChips = chips.filter((x) => x.text !== c.ui.noSignup && x.text !== c.ui.openSource && x.text !== c.ui.signupForm);
---

{compact ? (
<article class="lrow" id={toolId}>
  <span class="lrow__rank mono" aria-hidden="true">{String(rank).padStart(2, '0')}</span>
  <div class="lrow__body">
    <h3 class="lrow__name">
      <a href={href} target="_blank" rel="noopener">{name}</a>
      {kindTag && <span class="lcard__tag lcard__tag--kind">{kindTag}</span>}
      {tool.own && <span class="lcard__tag lcard__tag--own"><span class="lcard__seal" aria-hidden="true" lang="ja">櫻</span>{c.ui.own}</span>}
    </h3>
    <p class="lrow__note" dir={textDir}>{note}</p>
    <ul class="lrow__chips">
      {compactChips.map((chip) => <li class={`chipx chipx--${chip.kind}`}>{chip.text}</li>)}
      {github && <li class="chipx chipx--gh"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38v-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>GitHub</li>}
      {tool.openSource && <li><a class="lrow__src" href={tool.openSource} target="_blank" rel="noopener">{c.ui.source}</a></li>}
    </ul>
  </div>
  <a class="lrow__open" href={href} target="_blank" rel="noopener" aria-label={fill(c.ui.open, { name })}>
    <span class="lrow__host mono">{hostOf(href)}</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
  </a>
</article>
) : (

<article class="lcard" id={toolId} data-rank={rank}>
  <span class="lcard__rank mono" aria-hidden="true">{String(rank).padStart(2, '0')}</span>
  <div class="lcard__body">
    <header class="lcard__head">
      <h2 class="lcard__name">
        <a href={href} target="_blank" rel="noopener">{name}</a>
      </h2>
      {rank === 1 && <span class="lcard__tag lcard__tag--pick">{c.ui.pick}</span>}
      {kindTag && <span class="lcard__tag lcard__tag--kind">{kindTag}</span>}
      {tool.own && <span class="lcard__tag lcard__tag--own"><span class="lcard__seal" aria-hidden="true" lang="ja">櫻</span>{c.ui.own}</span>}
    </header>
    <p class="lcard__note" dir={textDir}>{note}</p>
    <ul class="lcard__chips">
      {chips.map((chip) => (
        <li class={`chipx chipx--${chip.kind}`}>
          {chip.kind === 'ok' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>}
          {chip.kind === 'warn' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v5M12 16.5v.01" /><circle cx="12" cy="12" r="9" /></svg>}
          {chip.text}
        </li>
      ))}
      {github && <li class="chipx chipx--gh"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38v-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>GitHub</li>}
      {tool.platforms?.map((p) => <li class="chipx chipx--plat">{p}</li>)}
    </ul>
    <footer class="lcard__foot">
      <span class:list={['lcard__checked mono', { 'is-tested': tested }]}>
        <svg viewBox="0 0 24 24" aria-hidden="true">{tested ? <path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3" /> : <path d="m5 12.5 4.5 4.5L19 7.5" />}</svg>
        <time datetime={tool.checked}>{checkedText}</time>
      </span>
      {tool.openSource && <a class="lcard__src" href={tool.openSource} target="_blank" rel="noopener">{c.ui.source}</a>}
      <a class="lcard__open" href={href} target="_blank" rel="noopener">
        <span>{fill(c.ui.open, { name })}</span>
        <span class="lcard__host mono">{hostOf(href)}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
      </a>
    </footer>
  </div>
</article>
)}

<style>
  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lcard {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 4px 20px;
    padding: 26px 28px 22px 22px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-card);
    box-shadow: var(--shadow-card);
    scroll-margin-top: 96px;
  }
  .lcard:target {
    border-color: var(--c);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 30%, transparent), var(--shadow-card);
  }
  .lcard__rank {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 4px solid var(--c);
    border-radius: 50%;
    background: var(--color-bg);
    font-size: 15px;
    font-weight: 700;
  }
  .lcard[data-rank='1'] .lcard__rank {
    background: color-mix(in srgb, var(--c) 20%, var(--color-bg));
  }
  .lcard__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }
  .lcard__name {
    margin: 0;
    font-size: 23px;
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .lcard__name a {
    color: inherit;
    text-decoration: none;
  }
  .lcard__name a:hover {
    text-decoration: underline;
    text-decoration-color: var(--c);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.18em;
  }
  .lcard__tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 10px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 700;
    white-space: nowrap;
  }
  .lcard__tag--pick {
    background: color-mix(in srgb, var(--c) 14%, transparent);
    color: color-mix(in srgb, var(--c) 72%, var(--color-fg));
  }
  .lcard__tag--kind {
    border: 1px dashed var(--hairline-strong);
    color: var(--color-muted);
  }
  .lcard__tag--own {
    padding-left: 4px;
    border: 1px solid var(--hairline-strong);
  }
  .lcard__seal {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 2px;
    background: var(--shu);
    color: #fff;
    font: 800 11px/1 var(--font-mincho);
  }
  .lcard__note {
    margin: 10px 0 0;
    max-width: 72ch;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-fg);
    text-wrap: pretty;
  }
  .lcard__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .chipx {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 28px;
    padding: 0 10px;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    background: var(--wash);
    color: var(--color-fg);
  }
  .chipx svg {
    width: 15px;
    height: 15px;
    flex: none;
  }
  .chipx--ok svg {
    color: #1f8a4c;
  }
  .chipx--warn {
    background: color-mix(in srgb, #d97706 11%, transparent);
  }
  .chipx--warn svg {
    color: #b45309;
  }
  .chipx--gh {
    background: #24292f;
    color: #fff;
  }
  .chipx--gh svg {
    fill: currentColor;
    stroke: none;
  }
  :global([data-theme='dark']) .chipx--gh {
    background: #f0f6fc;
    color: #0d1117;
  }
  .chipx--plat {
    background: none;
    border: 1px solid var(--hairline-strong);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  :global([data-theme='dark']) .chipx--ok svg {
    color: #4ade80;
  }
  :global([data-theme='dark']) .chipx--warn svg {
    color: #fbbf24;
  }
  .lcard__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--hairline);
  }
  .lcard__checked {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    color: var(--color-muted);
  }
  .lcard__checked svg {
    width: 15px;
    height: 15px;
  }
  .lcard__checked.is-tested {
    color: color-mix(in srgb, var(--c) 70%, var(--color-fg));
    font-weight: 700;
  }
  .lcard__src {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-muted);
  }
  .lcard__open {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 42px;
    padding: 0 14px 0 18px;
    border-radius: 10px;
    background: var(--sign);
    color: var(--sign-ink);
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global([data-theme='dark']) .lcard__open {
    background: var(--sign-ink);
    color: var(--sign);
  }
  .lcard__open:hover {
    transform: translateY(-1px);
  }
  .lcard__host {
    font-size: 12px;
    font-weight: 500;
    opacity: 0.7;
  }
  .lcard__open svg {
    width: 16px;
    height: 16px;
    stroke-width: 2.4;
  }
  /* ---------- 精簡列 ---------- */
  .lrow {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto;
    gap: 2px 16px;
    align-items: start;
    padding: 16px 4px;
    border-bottom: 1px solid var(--hairline);
    scroll-margin-top: 96px;
  }
  .lrow:target {
    background: color-mix(in srgb, var(--c) 8%, transparent);
  }
  .lrow__rank {
    padding-top: 3px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-muted);
  }
  .lrow__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0;
    font-size: 17.5px;
    font-weight: 800;
    line-height: 1.3;
  }
  .lrow__name a {
    color: inherit;
    text-decoration: none;
  }
  .lrow__name a:hover {
    text-decoration: underline;
    text-decoration-color: var(--c);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  .lrow__name .lcard__tag {
    height: 22px;
    font-size: 11.5px;
  }
  .lrow__note {
    margin: 5px 0 0;
    max-width: 70ch;
    font-size: 15px;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .lrow__chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px;
    margin: 9px 0 0;
    padding: 0;
    list-style: none;
  }
  .lrow__chips .chipx {
    height: 24px;
    padding: 0 8px;
    font-size: 12px;
  }
  .lrow__src {
    margin-left: 4px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-muted);
  }
  .lrow__open {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 10px 0 12px;
    border: 1px solid var(--hairline-strong);
    border-radius: 9px;
    color: var(--color-fg);
    text-decoration: none;
    white-space: nowrap;
  }
  .lrow__open:hover {
    border-color: var(--c);
  }
  .lrow__host {
    font-size: 12px;
    color: var(--color-muted);
  }
  .lrow__open svg {
    width: 15px;
    height: 15px;
    stroke-width: 2.4;
  }
  @media (max-width: 640px) {
    .lrow {
      grid-template-columns: 28px minmax(0, 1fr) auto;
      gap: 2px 10px;
    }
    .lrow__host {
      display: none;
    }
    .lcard {
      grid-template-columns: 1fr;
      padding: 20px 18px 18px;
    }
    .lcard__rank {
      position: absolute;
      top: 18px;
      right: 18px;
      width: 38px;
      height: 38px;
      border-width: 3px;
      font-size: 13px;
    }
    .lcard__head {
      padding-right: 48px;
    }
    .lcard__name {
      font-size: 21px;
    }
    .lcard__note {
      font-size: 15.5px;
    }
    .lcard__open {
      margin-left: 0;
      width: 100%;
      justify-content: center;
    }
    .lcard__host {
      display: none;
    }
  }
</style>

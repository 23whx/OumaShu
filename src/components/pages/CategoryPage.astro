---
// 分類頁：一條線路的落地頁（承接「free online image tools」「免费在线图片工具」這類搜索）
// 各語言版本共用：/categories/image/、/zh-cn/categories/image/ …
import Base from '../../layouts/Base.astro';
import ToolCard from '../ToolCard.astro';
import SiteFooter from '../SiteFooter.astro';
import LangMenu from '../LangMenu.astro';
import { getLines } from '../../data/lines';
import { categorySeo } from '../../data/seo';
import { SITE_URL, ids, toolListNode, breadcrumbNode } from '../../utils/schema';
import { dict, fill, localePath, type Locale } from '../../i18n/routes';
import { UI } from '../../i18n/ui';

export interface Props {
  locale: Locale;
  category: string;
}

const { locale, category } = Astro.props;
const t = dict(locale);
const ui = UI[locale];
const lines = getLines();
const line = lines.find((l) => l.id === category)!;
const lineLabel = t.categories?.[line.id] ?? line.name;
const seo = categorySeo(locale, line.id, line.name);
const lineTools = line.stations.map((s) => s.tool);
const others = lines.filter((l) => l.id !== line.id);
const home = localePath(locale, '/');
const path = `/categories/${line.id}/`;

const pageUrl = `${SITE_URL}${localePath(locale, path)}`;
const categorySchema = [
  toolListNode(pageUrl, seo.h1, lineTools, t),
  breadcrumbNode(pageUrl, [
    { name: 'OumaShu', url: `${SITE_URL}${home}` },
    { name: seo.h1, url: pageUrl },
  ]),
];
---

<Base
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  locale={locale}
  alternatePath={path}
  canonicalUrl={pageUrl}
  pageType="CollectionPage"
  schema={categorySchema}
  mainEntityId={ids.toolList(pageUrl)}
  breadcrumbId={ids.breadcrumb(pageUrl)}
>
  <header class="cbar">
    <div class="cbar__inner">
      <a class="brand" href={home} aria-label="OumaShu home">
        <span class="seal" aria-hidden="true" lang="ja">櫻</span>
        <span class="brand__name">OumaShu<span class="brand__ja" lang="ja">櫻滿集</span></span>
      </a>
      <form class="csearch" action={home} method="get" role="search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
        <label class="sr-only" for="csearch-q">{ui.searchAll}</label>
        <input id="csearch-q" name="q" type="search" placeholder={t.search_placeholder} autocomplete="off" />
      </form>
      <LangMenu locale={locale} path={path} />
    </div>
  </header>

  <main id="main-content" class="cpage" style={`--c:${line.meta.color}`}>
    <nav class="crumbs" aria-label={ui.breadcrumb}>
      <ol>
        <li><a href={home}>OumaShu</a></li>
        <li aria-current="page">{seo.h1}</li>
      </ol>
    </nav>

    <section class="chero">
      <span class="badge badge--lg chero__badge"><span>{line.meta.code}</span></span>
      <div class="chero__text">
        <h1>{seo.h1}</h1>
        <p class="chero__intro">{seo.intro}</p>
        <p class="chero__meta mono">
          {lineTools.length === 1 ? ui.toolsOne : fill(ui.toolsCount, { count: lineTools.length })} · {fill(ui.lineName, { name: lineLabel })} <span lang="ja">{line.meta.ja}</span>
        </p>
      </div>
    </section>

    <ol class="ctrack" style={`--n:${Math.min(line.stations.length, 7)}`} aria-label={fill(ui.lineName, { name: lineLabel })}>
      {line.stations.map((s) => (
        <li>
          <a href={`#tool-${s.tool.id}`}>
            <span class="ctrack__dot"></span>
            <span class="ctrack__code mono">{s.code}</span>
          </a>
        </li>
      ))}
    </ol>

    <h2 class="sr-only">{fill(ui.allTools, { name: seo.h1 })}</h2>
    <div class="dline__grid">
      {line.stations.map((s, i) => (
        <ToolCard tool={s.tool} code={s.code} lineId={line.id} eager={i < 3} locale={locale} />
      ))}
    </div>

    <section class="others" aria-labelledby="others-title">
      <h2 id="others-title">{ui.moreLines}</h2>
      <ul>
        {others.map((o) => (
          <li>
            <a href={localePath(locale, `/categories/${o.id}/`)} style={`--c:${o.meta.color}`}>
              <span class="others__code mono">{o.meta.code}</span>
              <span class="others__name">{categorySeo(locale, o.id, o.name).h1}</span>
              <span class="others__n mono">{o.stations.length}</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="others__home" href={home}>{ui.fullMap}</a>
    </section>
  </main>

  <SiteFooter locale={locale} />
</Base>

<style>
  .cbar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.72);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--hairline);
  }
  :global([data-theme='dark']) .cbar {
    background: rgba(12, 12, 13, 0.7);
  }
  .cbar__inner {
    max-width: 1320px;
    height: 64px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .csearch {
    position: relative;
    flex: 1;
    max-width: 420px;
    margin-left: auto;
  }
  .cbar__inner > :global(.lang) {
    margin-right: -9px;
  }
  .csearch svg {
    position: absolute;
    left: 12px;
    top: 50%;
    width: 17px;
    height: 17px;
    transform: translateY(-50%);
    color: var(--color-muted);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    pointer-events: none;
  }
  .csearch input {
    width: 100%;
    height: 38px;
    padding: 0 14px 0 38px;
    border: 1px solid var(--hairline);
    border-radius: 10px;
    background: var(--wash);
    color: var(--color-fg);
    font: 500 15px/1 var(--font-sans);
    outline: none;
  }
  .csearch input:focus {
    background: var(--color-card);
    border-color: var(--shu);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--shu) 22%, transparent);
  }

  .cpage {
    max-width: 1320px;
    margin: 0 auto;
    padding: 28px 32px 88px;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    color: var(--color-muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 6px;
    opacity: 0.5;
  }
  .crumbs a {
    color: inherit;
  }

  .chero {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin: 28px 0 0;
    padding-bottom: 28px;
    border-bottom: 3px solid var(--c);
  }
  .chero__badge {
    margin-top: 6px;
  }
  .chero h1 {
    margin: 0;
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .chero__intro {
    margin: 14px 0 0;
    max-width: 68ch;
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-muted);
    text-wrap: pretty;
  }
  .chero__meta {
    margin: 12px 0 0;
    font-size: 13px;
    color: var(--color-muted);
  }
  .chero__meta span {
    font-family: var(--font-ja);
  }

  /* 本線路的站點條 */
  .ctrack {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    width: min(100%, calc(var(--n) * 96px));
    margin: 26px 0 30px;
    padding: 0;
    list-style: none;
    row-gap: 12px;
  }
  .ctrack li {
    position: relative;
  }
  .ctrack li::before {
    content: '';
    position: absolute;
    top: 9px;
    left: 0;
    right: 0;
    height: 5px;
    border-radius: 3px;
    background: var(--c);
  }
  .ctrack a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    color: inherit;
    text-decoration: none;
  }
  .ctrack__dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 4.5px solid var(--c);
    background: var(--color-bg);
    transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1), background 160ms;
  }
  .ctrack a:hover .ctrack__dot,
  .ctrack a:focus-visible .ctrack__dot {
    transform: scale(1.25);
    background: var(--c);
  }
  .ctrack__code {
    font-size: 11px;
    color: var(--color-muted);
  }

  .others {
    margin-top: 72px;
  }
  .others h2 {
    margin: 0 0 16px;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .others ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .others a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-card);
    color: inherit;
    text-decoration: none;
    font-weight: 700;
    transition: border-color var(--transition-normal);
  }
  .others a:hover {
    border-color: var(--c);
  }
  .others__code {
    padding: 3px 5px 2px;
    border: 2px solid var(--c);
    border-radius: 6px;
    background: #fff;
    color: #18181b;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
  }
  .others__name {
    flex: 1;
    min-width: 0;
  }
  .others__n {
    font-size: 12px;
    color: var(--color-muted);
  }
  .others .others__home {
    display: inline-flex;
    margin-top: 18px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-brand-ink);
    font-weight: 800;
  }

  @media (max-width: 760px) {
    .cbar {
      position: static;
    }
    .cbar__inner {
      height: auto;
      padding: 12px 16px;
      flex-wrap: wrap;
      gap: 10px;
    }
    .cbar__inner > :global(.lang) {
      margin-left: auto;
    }
    .csearch {
      order: 3;
      flex-basis: 100%;
      max-width: none;
      margin-left: 0;
    }
    .cpage {
      padding: 20px 16px 64px;
    }
    .chero {
      gap: 14px;
    }
    .chero__intro {
      font-size: 16px;
    }
    .ctrack {
      width: min(100%, calc(var(--n) * 48px));
    }
    .ctrack__code {
      font-size: 9px;
      white-space: nowrap;
    }
  }
</style>

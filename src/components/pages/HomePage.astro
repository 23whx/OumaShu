---
// 首頁：各語言版本共用（/、/zh-cn/、/ja/…），文字在構建時按語言直接寫進 HTML
import Base from '../../layouts/Base.astro';
import ToolCard from '../ToolCard.astro';
import SiteFooter from '../SiteFooter.astro';
import LangMenu from '../LangMenu.astro';
import FaqSection from '../FaqSection.astro';
import { latestUpdate } from '../../data/stats';
import { tools } from '../../data/tools';
import { getLines } from '../../data/lines';
import { SITE_URL, ids, toolListNode } from '../../utils/schema';
import { homeSeo } from '../../data/seo';
import { dict, fill, localeInfo, localePath, type Locale } from '../../i18n/routes';
import { UI } from '../../i18n/ui';
import { LIB_PATH, libCopy } from '../../data/library';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dict(locale);
const seo = homeSeo(locale);
const lines = getLines();
const home = localePath(locale, '/');

// 結構化數據：首頁的主體是按線路排序的全部工具
const homeUrl = `${SITE_URL}${home}`;
const orderedTools = lines.flatMap((line) => line.stations.map((s) => s.tool));
const homeSchema = [toolListNode(homeUrl, UI[locale].toolListName, orderedTools, t)];

// 長線路在路線圖上折成多行，每行最多 7 站
const STATIONS_PER_ROW = 7;
const chunk = <T,>(items: T[], size: number): T[][] =>
  Array.from({ length: Math.ceil(items.length / size) }, (_, i) => items.slice(i * size, (i + 1) * size));
const themeLabels = { label: t.theme_label, ...t.theme };
const home_ = UI[locale].home;
const lib = libCopy(locale);
// 阿拉伯文輸入框從右往左打字（頁面整體仍是 ltr）
const dirAttr = locale === 'ar' ? 'rtl' : undefined;
---

<Base
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  locale={locale}
  alternatePath="/"
  dateModified={latestUpdate()}
  canonicalUrl={homeUrl}
  pageType="CollectionPage"
  schema={homeSchema}
  mainEntityId={ids.toolList(homeUrl)}
>
  <!-- 站牌頂欄 -->
  <header class="topbar">
    <div class="topbar__inner">
      <a class="brand" href={home}>
        <span class="seal" aria-hidden="true" lang="ja">櫻</span>
        <span class="brand__name">OumaShu<span class="brand__ja" lang="ja">櫻滿集</span></span>
      </a>

      <!-- 首屏搜索框捲出視窗後，頂欄才出現這個小搜索框（與首屏同步） -->
      <div class="search" role="search" data-dock inert>
        <svg class="search__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
        <label class="sr-only" for="dock-input">{t.nav.search}</label>
        <input id="dock-input" type="search" autocomplete="off" spellcheck="false" placeholder={t.search_placeholder} dir={dirAttr} />
        <kbd class="search__kbd" aria-hidden="true">/</kbd>
      </div>

      <div class="status">
        <span class="status__item" id="location-text"></span>
        <span class="status__item mono" id="time-text">--:--</span>
        <span class="status__item" id="weather-info">
          <svg class="wx" data-wx="clear" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.5M12 19v2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M2.5 12H5M19 12h2.5M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" /></svg>
          <svg class="wx" data-wx="cloud" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M7 18h10a4 4 0 0 0 .6-7.96A6 6 0 0 0 6.1 11 3.5 3.5 0 0 0 7 18Z" /></svg>
          <svg class="wx" data-wx="rain" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M7 15h10a4 4 0 0 0 .6-7.96A6 6 0 0 0 6.1 8 3.5 3.5 0 0 0 7 15ZM9 18l-1 2.5M13 18l-1 2.5M17 18l-1 2.5" /></svg>
          <svg class="wx" data-wx="snow" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M7 14h10a4 4 0 0 0 .6-7.96A6 6 0 0 0 6.1 7 3.5 3.5 0 0 0 7 14ZM8 18h.01M12 19h.01M16 18h.01M10 21h.01M14 21h.01" /></svg>
          <svg class="wx" data-wx="storm" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M7 14h10a4 4 0 0 0 .6-7.96A6 6 0 0 0 6.1 7 3.5 3.5 0 0 0 7 14ZM13 15l-2.5 3.5H14L11.5 22" /></svg>
          <svg class="wx" data-wx="fog" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M4 9h16M6 13h12M4 17h16" /></svg>
          <span class="mono" id="weather-text">--°</span>
        </span>
      </div>

      <div class="controls">
        <a class="navlink" href={localePath(locale, LIB_PATH)}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h3v16H5zM10 4h3v16h-3zM15.2 4.6l2.9-.8 3.9 15.5-2.9.8z" /></svg>
          <span>{lib.ui.library}</span>
        </a>
        <LangMenu locale={locale} path="/" />
        <button id="theme-toggle-btn" class="ctrl" type="button" data-mode="system" aria-label={t.theme_label} data-labels={JSON.stringify(themeLabels)}>
          <svg class="i-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.5M12 19v2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M2.5 12H5M19 12h2.5M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" /></svg>
          <svg class="i-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10Z" /></svg>
          <svg class="i-system" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="12" rx="1.5" /><path d="M9 20h6M12 16.5V20" /></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main-content">
    <!-- 首屏：站名牌 + 搜索（像搜索引擎一樣，進站先看到搜索框） -->
    <section class="gate" aria-labelledby="hero-title">
      <div class="gate__inner">
        <div class="gate__mark" aria-hidden="true">
          <span class="seal seal--lg" lang="ja">櫻</span>
          <span class="gate__name">
            <span class="gate__kanji" lang="ja">櫻滿集</span>
            <span class="gate__roman">Ōmashū</span>
          </span>
        </div>
        <ol class="gate__ribbon" aria-hidden="true">
          {lines.map((line, i) => <li style={`--c:${line.meta.color};--i:${i}`}></li>)}
        </ol>

        <h1 id="hero-title">{t.hero_title}</h1>

        <div class="qbox" role="search" data-qbox data-tpl={JSON.stringify({ seeAll: home_.seeAll, seeAllOne: home_.seeAllOne, noMatch: home_.noMatch, groupOwn: lib.ui.groupOwn, groupLibrary: lib.ui.groupLibrary, shelfHit: lib.ui.shelfHit })}
          data-lib-index={`/library-index/${localeInfo(locale).prefix || 'en'}.json`}>
          <label class="sr-only" for="search-input">{t.nav.search}</label>
          <svg class="qbox__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
          <input
            id="search-input"
            type="search"
            role="combobox"
            aria-expanded="false"
            aria-controls="qbox-list"
            aria-autocomplete="list"
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="search"
            placeholder={home_.placeholder}
            dir={dirAttr}
          />
          <kbd class="qbox__kbd" aria-hidden="true">/</kbd>
          <button type="button" class="qbox__go" data-qbox-go aria-label={t.nav.search}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
          <div class="qbox__panel" data-qbox-panel hidden>
            <ul class="qbox__list" id="qbox-list" role="listbox" aria-label={home_.results}></ul>
            <div class="qbox__empty" data-qbox-empty hidden>
              <p class="qbox__empty-title"></p>
              <p class="qbox__empty-hint">{home_.noHint}</p>
            </div>
            <button type="button" class="qbox__all" data-qbox-all></button>
          </div>
        </div>

        <p class="gate__try" dir={dirAttr}>
          <span class="gate__try-label">{home_.try}</span>
          {home_.suggestions.map((s) => <button type="button" class="gate__q" data-q={s}>{s}</button>)}
        </p>
        <a class="gate__lib" href={localePath(locale, LIB_PATH)}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h3v16H5zM10 4h3v16h-3zM15.2 4.6l2.9-.8 3.9 15.5-2.9.8z" /></svg>
          {lib.ui.browseLibrary} →
        </a>
      </div>

      <div class="gate__foot">
        <p id="hero-sub" data-tpl-tools={tools.length} data-tpl-lines={lines.length}>
          {fill(t.hero_sub, { tools: tools.length, lines: lines.length })}
        </p>
        <ul class="facts">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg><span id="intro-feature-free-title">{t.intro_feature_free_title}</span></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="9.5" rx="2" /><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" /></svg><span id="intro-feature-privacy-title">{t.intro_feature_privacy_title}</span></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3 5.5 13.5H12L11 21l7.5-10.5H12L13 3Z" /></svg><span id="intro-feature-noinstall-title">{t.intro_feature_noinstall_title}</span></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.5" /><path d="M5.5 19.5a6.5 6.5 0 0 1 13 0M4 4l16 16" /></svg><span id="fact-nosignup">{t.fact_nosignup}</span></li>
        </ul>
        <a class="gate__down" href="#route-map">
          <span>{fill(home_.browse, { lines: lines.length, tools: tools.length })}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v13M6 12l6 6 6-6" /></svg>
        </a>
      </div>
    </section>

    <!-- 線路圖 -->
    <section class="map" id="route-map" aria-labelledby="map-title">
      <h2 id="map-title" class="sr-only">{t.map_label}</h2>
      <ol class="map__lines">
        {lines.map((line, i) => (
          <li class:list={['mline', { 'mline--wide': line.stations.length > 3 }]} data-line={line.id} style={`--c:${line.meta.color};--i:${i}`}>
            <button type="button" class="mline__label" data-filter={line.id} aria-pressed="false">
              <span class="badge"><span>{line.meta.code}</span></span>
              <span class="mline__name">
                <span data-cat={line.id}>{t.categories[line.id] ?? line.name}</span>
                <span class="ja" lang="ja">{line.meta.ja}</span>
              </span>
            </button>
            <div class="mline__tracks">
              {chunk(line.stations, STATIONS_PER_ROW).map((row) => (
                <ol class="mline__track" style={`--n:${row.length}`}>
                  {row.map((s) => (
                    <li>
                      <a class="stn" href={`#tool-${s.tool.id}`} data-station={s.tool.id}>
                        <span class="stn__dot"></span>
                        <span class="stn__name" data-i18n-tool={s.tool.id}>{t[s.tool.id] ?? s.tool.name}</span>
                        <span class="stn__code mono">{s.code}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              ))}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- 線路篩選 -->
    <nav class="rail" aria-label={t.map_label}>
      <div class="rail__inner">
        <div class="rail__chips">
          <button type="button" class="chip is-on" data-filter="all" aria-pressed="true">
            <span id="all-lines-label">{t.all_lines}</span><span class="chip__n mono">{tools.length}</span>
          </button>
          {lines.map((line) => (
            <button type="button" class="chip" data-filter={line.id} aria-pressed="false" style={`--c:${line.meta.color}`}>
              <span class="chip__code mono">{line.meta.code}</span>
              <span data-cat={line.id}>{t.categories[line.id] ?? line.name}</span>
              <span class="chip__n mono">{line.stations.length}</span>
            </button>
          ))}
        </div>
      </div>
    </nav>

    <!-- 各線路的站 -->
    <div class="dir" id="directory" data-found={t.search_results_found} data-found-one={t.search_results_found_one}>
      <p id="search-status" class="dir__status" aria-live="polite"></p>
      {lines.map((line) => (
        <section class="dline" data-line={line.id} id={`line-${line.id}`} style={`--c:${line.meta.color}`} aria-labelledby={`line-title-${line.id}`}>
          <header class="dline__head">
            <span class="badge badge--lg"><span>{line.meta.code}</span></span>
            <h2 id={`line-title-${line.id}`}>
              <a class="dline__link" href={localePath(locale, `/categories/${line.id}/`)}>
                <span data-cat={line.id}>{t.categories[line.id] ?? line.name}</span>
                <span class="ja" lang="ja">{line.meta.ja}</span>
              </a>
            </h2>
            <span class="dline__count mono" data-count={line.stations.length}>
              {line.stations.length === 1 ? t.stations_count_one : fill(t.stations_count, { count: line.stations.length })}
            </span>
          </header>
          <div class="dline__grid">
            {line.stations.map((s) => (
              <ToolCard tool={s.tool} code={s.code} lineId={line.id} locale={locale} />
            ))}
          </div>
        </section>
      ))}

      <div id="empty-state" class="empty" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5M8.5 11h5" /></svg>
        <p id="empty-text">{t.search_no_results}</p>
        <button type="button" id="clear-search" class="empty__btn">{t.clear_search}</button>
      </div>
    </div>

    <FaqSection locale={locale} />
  </main>

  <SiteFooter locale={locale} />

</Base>

<script>
  // 頁面文字已按語言寫進 HTML；這裡只負責篩選、搜索、主題與天氣
  import { tools } from '../../data/tools';
  import { trackSearch } from '../../utils/track';

  const fill = (tpl: string, vals: Record<string, string | number>) =>
    tpl.replace(/\{\{(\w+)\}\}/g, (_, k) => String(vals[k] ?? ''));
  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel);
  const $$ = <T extends Element = HTMLElement>(sel: string) => Array.from(document.querySelectorAll<T>(sel));

  const toolById = new Map(tools.map((tool) => [tool.id, tool]));
  const cards = $$<HTMLElement>('.tcard');
  const sections = $$<HTMLElement>('.dline');
  const stations = $$<HTMLAnchorElement>('.stn');
  const mapLines = $$<HTMLElement>('.mline');
  const filterButtons = $$<HTMLButtonElement>('[data-filter]');
  const searchInput = $<HTMLInputElement>('#search-input')!;
  const dockInput = $<HTMLInputElement>('#dock-input')!;
  const dock = $('[data-dock]')!;
  const qbox = $('[data-qbox]')!;
  const panel = $('[data-qbox-panel]')!;
  const list = $('#qbox-list')!;
  const emptyBox = $('[data-qbox-empty]')!;
  const allBtn = $<HTMLButtonElement>('[data-qbox-all]')!;
  const tpl: Record<string, string> = JSON.parse(qbox.dataset.tpl || '{}');
  const searchStatus = $('#search-status')!;
  const emptyState = $('#empty-state')!;
  const directory = $('#directory')!;

  let filter = 'all';
  let query = '';

  // ---------- 搜索索引：本頁語言的名稱與描述 + 英文原名、描述與標籤（任何語言都能用英文搜）----------
  const haystack = new Map<string, string>();
  for (const card of cards) {
    const id = card.dataset.toolId!;
    const tool = toolById.get(id);
    const lineName = card.closest('.dline')?.querySelector('h2')?.textContent ?? '';
    const parts = [card.textContent ?? '', lineName];
    if (tool) parts.push(tool.name, tool.description, ...(tool.tags || []));
    haystack.set(id, parts.join(' ').replace(/\s+/g, ' ').toLowerCase());
  }

  // 多個詞用空格分開時，每個詞都要出現（「画像 圧縮」）
  const termsOf = (q: string) => q.trim().toLowerCase().split(/\s+/).filter(Boolean);
  // 拉丁 / 西里爾字母的長詞去掉詞尾再比（сжатие ↔ сжатия、images ↔ image）
  const stem = (term: string) =>
    /^[a-zа-яё]+$/.test(term) && term.length >= 5 ? term.slice(0, term.length >= 7 ? -2 : -1) : term;
  const matches = (id: string, terms: string[]) => {
    const text = haystack.get(id) || '';
    return terms.every((term) => text.includes(term) || text.includes(stem(term)));
  };

  // ---------- 篩選 / 搜索 ----------
  function apply() {
    const terms = termsOf(query);
    const q = terms.join(' ');
    let shown = 0;
    const visible = new Set<string>();

    for (const card of cards) {
      const id = card.dataset.toolId!;
      const lineOk = filter === 'all' || card.dataset.line === filter;
      const queryOk = !terms.length || matches(id, terms);
      const on = lineOk && queryOk;
      card.hidden = !on;
      if (on) {
        shown++;
        visible.add(id);
      }
    }
    for (const section of sections) {
      section.hidden = !section.querySelector('.tcard:not([hidden])');
    }
    for (const stn of stations) {
      stn.classList.toggle('is-dim', !visible.has(stn.dataset.station!));
    }
    for (const line of mapLines) {
      line.classList.toggle('is-dim', !line.querySelector('.stn:not(.is-dim)'));
    }
    for (const btn of filterButtons) {
      const on = btn.dataset.filter === filter;
      btn.classList.toggle('is-on', on);
      btn.setAttribute('aria-pressed', String(on));
    }

    emptyState.hidden = shown > 0;
    searchStatus.textContent = q && shown > 0
      ? shown === 1 && directory.dataset.foundOne
        ? directory.dataset.foundOne
        : fill(directory.dataset.found || 'Found {{count}} tools', { count: shown })
      : '';
  }

  // ---------- 首屏搜索框的即時建議 ----------
  const info = new Map(cards.map((card) => {
    const main = card.querySelector<HTMLAnchorElement>('.tcard__main')!;
    return [card.dataset.toolId!, {
      name: main.textContent?.trim() ?? '',
      href: main.href,
      desc: card.querySelector('.tcard__desc')?.textContent?.trim() ?? '',
      code: card.querySelector('.tcard__code')?.textContent?.trim() ?? '',
      color: card.closest<HTMLElement>('.dline')?.style.getPropertyValue('--c') ?? '',
    }];
  }));
  const MAX_OWN = 5;
  const MAX_LIB = 4;
  let active = -1;
  // 建議列表裡的每一列：本站工具在新分頁打開，圖書館書架在本頁打開
  type Opt = { key: string; href: string; external: boolean; code: string; color: string; name: string; desc: string };
  let options: Opt[] = [];
  let ownCount = 0;

  // 名稱命中的排前面，其次是描述與標籤命中的
  function rank(terms: string[]) {
    const ids = cards.map((c) => c.dataset.toolId!).filter((id) => matches(id, terms));
    const score = (id: string) => {
      const name = (info.get(id)?.name ?? '').toLowerCase();
      if (name.startsWith(terms[0])) return 0;
      if (terms.every((term) => name.includes(term))) return 1;
      return 2;
    };
    return ids.map((id, i) => ({ id, s: score(id) * 1000 + i })).sort((a, b) => a.s - b.s).map((r) => r.id);
  }

  // ---------- 工具圖書館索引：第一次用搜索框時才載入 ----------
  type LibShelf = { id: string; code: string; color: string; name: string; intro: string; href: string; count: number; text: string; tools: string[] };
  type LibToolHit = { name: string; shelf: string; href: string; code: string; color: string };
  let lib: { shelves: LibShelf[]; tools: LibToolHit[] } | null = null;
  let libLoading: Promise<void> | null = null;
  function loadLibrary() {
    libLoading ??= fetch(qbox.dataset.libIndex!)
      .then((r) => (r.ok ? r.json() : null))
      .then((data) => {
        lib = data;
        if (searchInput.value.trim() && !panel.hidden) suggest();
      })
      .catch(() => {});
    return libLoading;
  }
  searchInput.addEventListener('focus', loadLibrary, { once: true });
  searchInput.addEventListener('pointerenter', loadLibrary, { once: true });

  function libraryHits(terms: string[]): Opt[] {
    if (!lib) return [];
    const has = (text: string) => terms.every((t) => text.includes(t) || text.includes(stem(t)));
    const shelves = lib.shelves
      .filter((s) => has(`${s.text} ${s.tools.join(' ').toLowerCase()}`))
      .map((s) => ({
        key: `lib-${s.id}`, href: s.href, external: false, code: s.code, color: s.color,
        name: s.name, desc: `${fill(tpl.shelfHit || '', { count: s.count })} ${s.tools.join(' / ')}`,
      }));
    // 工具名直接命中、而且它的書架還沒列出來時，補一列
    const shown = new Set(shelves.map((s) => s.href));
    const tools = lib.tools
      .filter((t) => has(t.name.toLowerCase()) && !shown.has(t.href.split('#')[0]))
      .map((t) => ({ key: `lib-t-${t.href}`, href: t.href, external: false, code: t.code, color: t.color, name: t.name, desc: t.shelf }));
    return [...shelves, ...tools].slice(0, MAX_LIB);
  }

  function setActive(i: number) {
    active = i;
    list.querySelectorAll<HTMLElement>('[role="option"]').forEach((opt, j) => {
      opt.setAttribute('aria-selected', String(j === i));
      // 只捲動建議面板本身，不帶動整頁
      if (j === i) {
        const top = opt.offsetTop;
        const bottom = top + opt.offsetHeight;
        if (top < panel.scrollTop) panel.scrollTop = top;
        else if (bottom > panel.scrollTop + panel.clientHeight) panel.scrollTop = bottom - panel.clientHeight;
      }
    });
    if (i >= 0) searchInput.setAttribute('aria-activedescendant', `qopt-${i}`);
    else searchInput.removeAttribute('aria-activedescendant');
  }

  function openPanel(open: boolean) {
    panel.hidden = !open;
    qbox.classList.toggle('is-open', open);
    searchInput.setAttribute('aria-expanded', String(open));
    if (!open) setActive(-1);
  }

  function optionRow(o: Opt, i: number) {
    const li = document.createElement('li');
    li.id = `qopt-${i}`;
    li.setAttribute('role', 'option');
    li.setAttribute('aria-selected', 'false');
    li.style.setProperty('--c', o.color);
    const a = document.createElement('a');
    a.className = 'qopt';
    a.href = o.href;
    if (o.external) {
      a.target = '_blank';
      a.rel = 'noopener';
    }
    a.tabIndex = -1;
    const badge = document.createElement('span');
    badge.className = 'qopt__code mono';
    badge.textContent = o.code;
    const text = document.createElement('span');
    text.className = 'qopt__text';
    const name = document.createElement('span');
    name.className = 'qopt__name';
    name.textContent = o.name;
    const desc = document.createElement('span');
    desc.className = 'qopt__desc';
    desc.textContent = o.desc;
    text.append(name, desc);
    const arrow = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    arrow.setAttribute('viewBox', '0 0 24 24');
    arrow.setAttribute('aria-hidden', 'true');
    arrow.classList.add('qopt__go');
    arrow.innerHTML = o.external ? '<path d="M7 17 17 7M9 7h8v8" />' : '<path d="M5 12h13M13 6l6 6-6 6" />';
    a.append(badge, text, arrow);
    li.append(a);
    return li;
  }

  function groupHead(label: string) {
    const li = document.createElement('li');
    li.className = 'qgroup';
    li.setAttribute('role', 'presentation');
    li.textContent = label;
    return li;
  }

  function suggest() {
    const terms = termsOf(searchInput.value);
    if (!terms.length) {
      openPanel(false);
      return;
    }
    const own = rank(terms);
    ownCount = own.length;
    const ownOpts: Opt[] = own.slice(0, MAX_OWN).map((id) => {
      const d = info.get(id)!;
      return { key: id, href: d.href, external: true, code: d.code, color: d.color, name: d.name, desc: d.desc };
    });
    const libOpts = libraryHits(terms);
    options = [...ownOpts, ...libOpts];

    const rows: HTMLElement[] = [];
    if (ownOpts.length) {
      if (libOpts.length) rows.push(groupHead(tpl.groupOwn || ''));
      ownOpts.forEach((o, i) => rows.push(optionRow(o, i)));
    }
    if (libOpts.length) {
      rows.push(groupHead(tpl.groupLibrary || ''));
      libOpts.forEach((o, i) => rows.push(optionRow(o, ownOpts.length + i)));
    }
    list.replaceChildren(...rows);

    emptyBox.hidden = options.length > 0;
    emptyBox.querySelector('.qbox__empty-title')!.textContent = fill(tpl.noMatch || '', { q: searchInput.value.trim() });
    allBtn.hidden = ownCount === 0;
    allBtn.textContent = ownCount === 1 ? tpl.seeAllOne : fill(tpl.seeAll || '', { count: ownCount });
    setActive(-1);
    openPanel(true);
    trackSearch('home', searchInput.value, options.length);
  }

  // 帶著結果「下車」到目錄
  function goToResults() {
    openPanel(false);
    directory.scrollIntoView({ block: 'start' });
  }

  // 兩個搜索框共用同一個查詢
  let searchTimer: number | undefined;
  function onType(from: HTMLInputElement) {
    const other = from === searchInput ? dockInput : searchInput;
    other.value = from.value;
    if (from === searchInput) suggest();
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      query = from.value;
      apply();
    }, 120);
  }
  function clearQuery() {
    searchInput.value = '';
    dockInput.value = '';
    query = '';
    openPanel(false);
    apply();
  }

  searchInput.addEventListener('input', () => onType(searchInput));
  dockInput.addEventListener('input', () => {
    onType(dockInput);
    trackSearch('home-topbar', dockInput.value, rank(termsOf(dockInput.value)).length);
    if (directory.getBoundingClientRect().top > window.innerHeight * 0.6) directory.scrollIntoView({ block: 'start' });
  });
  searchInput.addEventListener('focus', () => searchInput.value.trim() && suggest());
  searchInput.addEventListener('keydown', (e) => {
    const n = options.length;
    if (e.key === 'ArrowDown' && !panel.hidden && n) {
      e.preventDefault();
      setActive((active + 1) % n);
    } else if (e.key === 'ArrowUp' && !panel.hidden && n) {
      e.preventDefault();
      setActive(active <= 0 ? n - 1 : active - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (active >= 0) list.querySelectorAll<HTMLAnchorElement>('.qopt')[active]?.click();
      else if (searchInput.value.trim()) {
        window.clearTimeout(searchTimer);
        query = searchInput.value;
        apply();
        goToResults();
      }
    } else if (e.key === 'Escape') {
      if (!panel.hidden) openPanel(false);
      else {
        clearQuery();
        searchInput.blur();
      }
    }
  });
  dockInput.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      clearQuery();
      dockInput.blur();
    }
  });
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!qbox.contains(target) && !target.closest('.gate__q')) openPanel(false);
  });
  allBtn.addEventListener('click', goToResults);
  $('[data-qbox-go]')!.addEventListener('click', () => {
    if (!searchInput.value.trim()) {
      searchInput.focus();
      return;
    }
    window.clearTimeout(searchTimer);
    query = searchInput.value;
    apply();
    goToResults();
  });
  for (const btn of $$<HTMLButtonElement>('.gate__q')) {
    btn.addEventListener('click', () => {
      searchInput.value = btn.dataset.q!;
      onType(searchInput);
      searchInput.focus();
    });
  }

  // 首屏搜索框捲出視窗時，頂欄顯示小搜索框
  new IntersectionObserver(([entry]) => {
    const docked = !entry.isIntersecting;
    dock.classList.toggle('is-docked', docked);
    dock.toggleAttribute('inert', !docked);
    if (docked) openPanel(false);
  }, { rootMargin: '-64px 0px 0px 0px' }).observe(qbox);

  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    const typing = target.closest('input, textarea, select, [contenteditable="true"]');
    if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey && !e.altKey) {
      e.preventDefault();
      const input = dock.classList.contains('is-docked') && dock.offsetParent ? dockInput : searchInput;
      input.focus();
      input.select();
    }
  });

  $('#clear-search')!.addEventListener('click', () => {
    clearQuery();
    filter = 'all';
    apply();
    (dock.classList.contains('is-docked') && dock.offsetParent ? dockInput : searchInput).focus();
  });

  for (const btn of filterButtons) {
    btn.addEventListener('click', () => {
      const id = btn.dataset.filter!;
      filter = id === filter && id !== 'all' ? 'all' : id;
      apply();
      // 從線路圖點擊時，乘車到目錄
      if (btn.classList.contains('mline__label')) {
        directory.scrollIntoView({ block: 'start' });
      }
    });
  }

  // ---------- 站點 ↔ 卡片 ----------
  for (const stn of stations) {
    stn.addEventListener('click', (e) => {
      const id = stn.dataset.station!;
      const card = document.getElementById(`tool-${id}`);
      if (!card) return;
      e.preventDefault();
      if (card.hidden) {
        filter = 'all';
        clearQuery();
      }
      card.scrollIntoView({ block: 'center' });
      card.classList.remove('is-arrive');
      void card.offsetWidth;
      card.classList.add('is-arrive');
      card.querySelector<HTMLAnchorElement>('.tcard__main')?.focus({ preventScroll: true });
    });
  }
  for (const card of cards) {
    const stn = document.querySelector(`.stn[data-station="${card.dataset.toolId}"]`);
    const on = () => stn?.classList.add('is-hover');
    const off = () => stn?.classList.remove('is-hover');
    card.addEventListener('pointerenter', on);
    card.addEventListener('pointerleave', off);
    card.addEventListener('focusin', on);
    card.addEventListener('focusout', off);
    card.addEventListener('animationend', () => card.classList.remove('is-arrive'));
  }

  // ---------- 主題 ----------
  const themeBtn = $<HTMLButtonElement>('#theme-toggle-btn')!;
  const themeLabels: Record<string, string> = JSON.parse(themeBtn.dataset.labels || '{}');
  let themeMode = 'system';
  try { themeMode = localStorage.getItem('theme') || 'system'; } catch {}
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  function applyTheme(mode: string) {
    themeMode = mode;
    const actual = mode === 'system' ? (media.matches ? 'dark' : 'light') : mode;
    document.documentElement.setAttribute('data-theme', actual);
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', actual === 'dark' ? '#0c0c0d' : '#ffffff');
    themeBtn.dataset.mode = mode;
    themeBtn.setAttribute('aria-label', `${themeLabels.label || 'Theme'}: ${themeLabels[mode] || mode}`);
  }
  themeBtn.addEventListener('click', () => {
    const order = ['light', 'dark', 'system'];
    const next = order[(order.indexOf(themeMode) + 1) % order.length];
    try { localStorage.setItem('theme', next); } catch {}
    applyTheme(next);
  });
  media.addEventListener('change', () => themeMode === 'system' && applyTheme('system'));
  applyTheme(themeMode);

  // ---------- 時間 / 地點 / 天氣 ----------
  const timeText = $('#time-text')!;
  function tick() {
    const now = new Date();
    timeText.textContent = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
  }
  tick();
  window.setInterval(tick, 30000);

  function weatherKind(code: number) {
    if (code <= 1) return 'clear';
    if (code <= 3) return 'cloud';
    if (code === 45 || code === 48) return 'fog';
    if ((code >= 71 && code <= 77) || code === 85 || code === 86) return 'snow';
    if (code >= 95) return 'storm';
    return 'rain';
  }

  const geo: Promise<Record<string, any> | null> = fetch('https://ipapi.co/json/')
    .then((r) => (r.ok ? r.json() : null))
    .catch(() => null);

  async function loadWeather() {
    const data = await geo;
    if (!data) return;
    if (data.city) $('#location-text')!.textContent = `${data.city}, ${data.country_code}`;
    if (data.latitude == null || data.longitude == null) return;
    try {
      const res = await fetch(
        `https://api.open-meteo.com/v1/forecast?latitude=${data.latitude}&longitude=${data.longitude}&current_weather=true&timezone=auto`
      );
      const w = (await res.json()).current_weather;
      if (!w) return;
      $('#weather-text')!.textContent = `${Math.round(w.temperature)}°C`;
      const kind = weatherKind(w.weathercode);
      for (const icon of $$<SVGElement>('.wx')) {
        if (icon.dataset.wx === kind) icon.removeAttribute('hidden');
        else icon.setAttribute('hidden', '');
      }
    } catch {}
  }
  loadWeather();
  window.setInterval(loadWeather, 1800000);

  // ?q= 站內搜索（schema.org SearchAction 與分類頁搜索框的入口）
  const initialQuery = new URLSearchParams(location.search).get('q');
  if (initialQuery) {
    searchInput.value = initialQuery;
    dockInput.value = initialQuery;
    query = initialQuery;
    apply();
    directory.scrollIntoView({ block: 'start' });
  }
</script>


---
import { LOCALES, localeInfo, localePath, type Locale } from '../i18n/routes';
import { UI } from '../i18n/ui';
import LangSuggest from '../components/LangSuggest.astro';
import { graph, pageNode, siteNodes, type PageType } from '../utils/schema';
import { LINE_META } from '../data/lines';
import '../styles/global.css';
import '../styles/site.css';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  locale?: Locale;
  /** 語言無關的路徑（"/"、"/categories/image/"）；有值時輸出各語言版本的 hreflang */
  alternatePath?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogVideo?: string | null;
  canonicalUrl?: string;
  noindex?: boolean;
  /** 本頁的 schema.org 類型 */
  pageType?: PageType;
  /** 本頁額外的 JSON-LD 節點（工具清單、麵包屑…） */
  schema?: object[];
  mainEntityId?: string;
  breadcrumbId?: string;
}

const {
  title = 'OumaShu - Tools Directory',
  description = 'Curated hub for productivity tools. All-in-one entry for free online apps and utilities.',
  keywords = 'tools, productivity, directory, apps, utilities',
  locale = 'en',
  alternatePath,
  ogImage = '/og/oumashu-og.jpg',
  ogImageAlt = 'OumaShu 櫻滿集 — a vermilion seal and the words "Every free tool, one stop away." surrounded by colored route lines and tool screenshots',
  ogVideo = '/og/oumashu-og.mp4',
  canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href,
  noindex = false,
  pageType = 'WebPage',
  schema = [],
  mainEntityId,
  breadcrumbId,
} = Astro.props;

// 版面固定 LTR（阿拉伯文只換文字，不鏡像版面）
const textDirection = 'ltr';
const ui = UI[locale];
const siteName = 'OumaShu';
const origin = (Astro.site ?? Astro.url).origin;
const ogImageUrl = new URL(ogImage, origin).href;
const ogVideoUrl = ogVideo ? new URL(ogVideo, origin).href : null;
const current = localeInfo(locale);
// 各語言版本（含 x-default → 英文版）
const alternates = alternatePath
  ? LOCALES.flatMap((l) => l.hreflang.map((hreflang, i) => ({
      hreflang,
      href: new URL(localePath(l.id, alternatePath), origin).href,
      locale: i === 0 ? l.id : undefined,
    })))
  : [];
const ogAlternates = alternatePath ? LOCALES.filter((l) => l.id !== locale).map((l) => l.og) : [];

// ---- 字體 ----
const GF = 'https://fonts.googleapis.com/css2?';
// 每種語言都會出現的日文字：線路日文名、櫻滿集
const jaGlyphs = [...new Set([...Object.values(LINE_META).map((m) => m.ja).join(''), ...'櫻滿集'])].join('');
const FONT_SHEETS = [
  `${GF}family=Overpass:wght@400;500;600;700;800;900&family=Overpass+Mono:wght@500;600&display=swap`,
  `${GF}family=Zen+Kaku+Gothic+New:wght@500;700;900&text=${encodeURIComponent(jaGlyphs)}&display=swap`,
  `${GF}family=Shippori+Mincho+B1:wght@600;800&text=${encodeURIComponent('櫻滿集')}&display=swap`,
];
// 介面切換到中日文時才載入的完整字體
const CJK_SHEETS: Record<string, string> = {
  'zh-CN': `${GF}family=Noto+Sans+SC:wght@400;500;700;900&display=swap`,
  'zh-TW': `${GF}family=Noto+Sans+TC:wght@400;500;700;900&display=swap`,
  'ja-JP': `${GF}family=Zen+Kaku+Gothic+New:wght@500;700;900&display=swap`,
};

// 結構化數據：網站與組織 + 當前頁 + 頁面自帶的節點
const jsonLd = graph([
  ...siteNodes(),
  pageNode({ url: canonicalUrl, type: pageType, name: title, description, mainEntityId, breadcrumbId, inLanguage: locale }),
  ...schema,
]);
---

<!DOCTYPE html>
<html lang={locale} dir={textDirection} data-theme="light" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- 基础 SEO -->
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <link rel="canonical" href={canonicalUrl}>
  
  <!-- Robots -->
  {noindex && <meta name="robots" content="noindex, nofollow">}
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={siteName}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:locale" content={current.og}>
  {ogAlternates.map((l) => <meta property="og:locale:alternate" content={l}>)}
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:image:secure_url" content={ogImageUrl}>
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={ogImageAlt}>
  {ogVideoUrl && (
    <>
      <meta property="og:video" content={ogVideoUrl}>
      <meta property="og:video:secure_url" content={ogVideoUrl}>
      <meta property="og:video:type" content="video/mp4">
      <meta property="og:video:width" content="1200">
      <meta property="og:video:height" content="630">
    </>
  )}

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@Rollkey4">
  <meta name="twitter:creator" content="@Rollkey4">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageUrl}>
  <meta name="twitter:image:alt" content={ogImageAlt}>

  <!-- Hreflang：每種語言一個網址，x-default 指向英文版 -->
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} data-locale={a.locale}>)}
  {alternatePath && <link rel="alternate" hreflang="x-default" href={new URL(alternatePath, origin).href}>}
  {alternatePath && locale === 'en' && (
    <!-- 使用者曾在選單裡選過其他語言：從英文版直接帶到該語言版本（爬蟲沒有 localStorage，不受影響） -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('locale');
          if (!saved || saved === 'en') return;
          var link = document.querySelector('link[rel="alternate"][data-locale="' + saved + '"]');
          if (link) location.replace(new URL(link.href).pathname + location.search + location.hash);
        } catch (e) {}
      })();
    </script>
  )}
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/logo.png">
  <link rel="manifest" href="/manifest.json">
  
  <!-- Theme -->
  <meta name="theme-color" content="#ffffff">

  <!-- Fonts: Overpass（道路標識系）＋ Zen Kaku Gothic New（日文）-->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://pagead2.googlesyndication.com">
  <!-- 字體：全部非阻塞載入（先用系統字體顯示，字體到了再替換）。
       日文與明朝體在所有語言下只用來顯示固定幾個字，用 text= 只取這些字；
       完整的中日文字體只在切換到對應語言時才下載（見下方腳本）。 -->
  {FONT_SHEETS.map((href) => (
    <>
      <link rel="preload" as="style" href={href} onload="this.onload=null;this.rel='stylesheet'">
      <noscript><link rel="stylesheet" href={href}></noscript>
    </>
  ))}
  <script is:inline define:vars={{ cjkSheets: CJK_SHEETS }}>
    (function () {
      var loaded = {};
      function load(lang) {
        var href = cjkSheets[lang];
        if (!href || loaded[lang]) return;
        loaded[lang] = true;
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = href;
        document.head.appendChild(link);
      }
      var root = document.documentElement;
      load(root.lang);
      new MutationObserver(function () { load(root.lang); })
        .observe(root, { attributes: true, attributeFilter: ['lang'] });
    })();
  </script>

  <!-- 关键CSS内联：站牌色票 -->
  <style>
    :root {
      --shu: #c8372d;            /* 朱：品牌與強調 */
      --sign: #1c1c1e;           /* 墨：頁尾、選中的篩選 */
      --sign-2: #2c2c2e;
      --sign-ink: #ffffff;
      --sign-mute: #a1a1a6;
      --color-bg: #ffffff;
      --color-panel: #f5f5f5;
      --color-fg: #18181b;
      --color-card: #ffffff;
      --color-brand: #c8372d;
      --color-brand-ink: #b02f26;
      --color-border: #e5e5e5;
      --color-muted: #5f5f66;
      --hairline: rgba(0, 0, 0, .08);
      --hairline-strong: rgba(0, 0, 0, .14);
      --wash: rgba(0, 0, 0, .035);
      --wash-strong: rgba(0, 0, 0, .06);
      --shadow-card: 0 1px 2px rgba(0, 0, 0, .05), 0 6px 18px -8px rgba(0, 0, 0, .16);
      --shadow-lift: 0 2px 4px rgba(0, 0, 0, .06), 0 18px 36px -14px rgba(0, 0, 0, .28);
      /* 漢字字體隨介面語言切換：日文 Zen Kaku、簡體 Noto Sans SC、繁體 Noto Sans TC */
      --font-cjk: 'Zen Kaku Gothic New', 'Hiragino Sans', 'Noto Sans JP';
      --font-sans: 'Overpass', var(--font-cjk), 'PingFang SC', 'Microsoft YaHei', 'Segoe UI', system-ui, sans-serif;
      --font-ja: 'Zen Kaku Gothic New', 'Hiragino Sans', 'Noto Sans JP', sans-serif;
      --font-mincho: 'Shippori Mincho B1', 'Hiragino Mincho ProN', 'Yu Mincho', serif;
      --font-mono: 'Overpass Mono', ui-monospace, 'SFMono-Regular', Consolas, monospace;
      --transition-normal: 200ms cubic-bezier(.16, 1, .3, 1);
      color-scheme: light;
    }

    :root[data-theme='dark'] {
      --shu: #d0402f;
      --sign: #0c0c0d;
      --sign-2: #1c1c1e;
      --sign-ink: #f2f2f2;
      --sign-mute: #9a9aa0;
      --color-bg: #0c0c0d;
      --color-panel: #131314;
      --color-fg: #ededed;
      --color-card: #18181a;
      --color-brand: #e0574b;
      --color-brand-ink: #f07a6e;
      --color-border: #2a2a2d;
      --color-muted: #a1a1a6;
      --hairline: rgba(255, 255, 255, .08);
      --hairline-strong: rgba(255, 255, 255, .14);
      --wash: rgba(255, 255, 255, .05);
      --wash-strong: rgba(255, 255, 255, .09);
      --shadow-card: 0 1px 2px rgba(0, 0, 0, .4), 0 8px 22px -10px rgba(0, 0, 0, .6);
      --shadow-lift: 0 2px 6px rgba(0, 0, 0, .45), 0 22px 40px -16px rgba(0, 0, 0, .75);
      color-scheme: dark;
    }

    :root[lang='zh-CN'] {
      --font-cjk: 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei';
    }

    :root[lang='zh-TW'] {
      --font-cjk: 'Noto Sans TC', 'PingFang TC', 'Microsoft JhengHei';
    }

    * { box-sizing: border-box; }

    html { font-family: var(--font-sans); }

    body {
      margin: 0;
      padding: 0;
      background-color: var(--color-bg);
      color: var(--color-fg);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
  </style>

  <!-- 主题初始化脚本 (防止闪烁) -->
  <script is:inline>
    (function() {
      function getTheme() {
        const stored = localStorage.getItem('theme');
        if (stored && ['light', 'dark', 'system'].includes(stored)) {
          return stored === 'system' 
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : stored;
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      
      const theme = getTheme();
      document.documentElement.setAttribute('data-theme', theme);
      
      // 更新 meta theme-color
      const metaThemeColor = document.querySelector('meta[name="theme-color"]');
      if (metaThemeColor) {
        metaThemeColor.setAttribute('content', theme === 'dark' ? '#0c0c0d' : '#ffffff');
      }
    })();
  </script>
  
  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4880646654838411"
     crossorigin="anonymous"></script>
  
  <!-- 结构化数据 -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  
  <!-- Google Analytics 4 (可选) -->
  <!-- <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XXXXXXXXXX');
  </script> -->
</head>

<body class="min-h-screen">
  <!-- Skip to main content (accessibility) -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 skip-link">
    {ui.skip}
  </a>
  
  <!-- Page content -->
  <slot />
  {alternatePath && <LangSuggest locale={locale} />}
  
  <!-- Service Worker 注册 (可选) -->
  <!-- 如需 PWA 功能，请创建 /public/sw.js 文件并取消下面的注释
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js')
          .then(registration => console.log('SW registered'))
          .catch(error => console.log('SW registration failed'));
      });
    }
  </script>
  -->
</body>
</html>

<style is:global>
  /* 全局样式增强 */
  html {
    font-family: var(--font-sans);
    scroll-behavior: smooth;
    scroll-padding-top: 132px;
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }

  body {
    background: var(--color-bg);
    color: var(--color-fg);
    line-height: 1.6;
  }
  
  /* Screen reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  
  .sr-only.focus\:not-sr-only:focus {
    position: static;
    width: auto;
    height: auto;
    padding: 0.5rem 1rem;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }
  
  /* 文本截断工具类 */
  .line-clamp-1 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }
  
  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  
  .line-clamp-3 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }
  
  /* 加载状态样式 */
  .loading {
    pointer-events: none;
    opacity: 0.6;
  }
  
  /* 动画 */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .fade-in {
    animation: fadeIn 0.3s ease-out;
  }
  
  /* 自定义滚动条 */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  
  ::-webkit-scrollbar-track {
    background: var(--color-bg);
  }
  
  ::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 4px;
  }
  
  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-muted);
  }
  
  /* 选择文本样式 */
  ::selection {
    background-color: color-mix(in srgb, var(--color-brand) 32%, transparent);
    color: var(--color-fg);
  }

  html { scrollbar-color: color-mix(in srgb, var(--color-muted) 45%, transparent) transparent; caret-color: var(--color-brand); accent-color: var(--color-brand); }

  a { text-underline-offset: .2em; }

  .skip-link:focus {
    position: fixed; top: 12px; left: 12px; z-index: 100;
    background: var(--sign); color: var(--sign-ink);
    padding: .6rem 1rem; border-radius: 6px; font-weight: 700;
  }
  
  /* 焦点样式 */
  :focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
    border-radius: 4px;
  }
</style>

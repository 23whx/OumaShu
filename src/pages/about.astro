---
// 關於頁：只寫可核實的事實（數量、收錄標準、作者、資金來源、更新日期），供讀者與搜索引擎 / AI 引用
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getLines } from '../data/lines';
import { categorySeo } from '../data/seo';
import { ids } from '../utils/schema';
import { TOOL_COUNT, LINE_COUNT, OWN_COUNT, THIRD_PARTY_COUNT, latestUpdate, formatDate } from '../data/stats';
import { LOCALES, localePath } from '../i18n/routes';
import en from '../locales/en.json';

const t = en as Record<string, any>;

const lines = getLines();
const updated = latestUpdate();
const EMAIL = 'wanghongxiang23@gmail.com';
---

<Base
  title="About OumaShu (櫻滿集): Who Makes It and How Tools Are Chosen"
  description={`OumaShu is a free directory of ${TOOL_COUNT} browser tools, built by independent developer Rollkey. How tools are chosen, what is listed, and how the site is funded.`}
  keywords="about oumashu, 櫻滿集, rollkey, free online tools directory"
  pageType="AboutPage"
  mainEntityId={ids.organization}
  dateModified={updated}
>
  <main id="main-content" class="about">
    <a class="brand" href="/">
      <span class="seal" aria-hidden="true" lang="ja">櫻</span>
      <span class="brand__name">OumaShu<span class="brand__ja" lang="ja">櫻滿集</span></span>
    </a>

    <h1>About OumaShu</h1>
    {updated && <p class="about__date mono">Last updated: <time datetime={updated.slice(0, 10)}>{formatDate(updated, 'en')}</time></p>}

    <p class="about__lead">
      OumaShu (櫻滿集) is a free directory of {TOOL_COUNT} online tools that open directly in a web browser.
      The tools are grouped into {LINE_COUNT} “lines”, drawn like a train map, so you can find an image compressor,
      a screen recorder or a Markdown editor without installing anything or creating an account.
    </p>

    <dl class="about__facts">
      <div><dt>Tools listed</dt><dd>{TOOL_COUNT}</dd></div>
      <div><dt>Built by OumaShu</dt><dd>{OWN_COUNT}</dd></div>
      <div><dt>Third-party sites</dt><dd>{THIRD_PARTY_COUNT}</dd></div>
      <div><dt>Languages</dt><dd>{LOCALES.length}</dd></div>
    </dl>

    <h2 id="how-tools-are-chosen">How are tools chosen?</h2>
    <p>A tool is listed only if it meets all three conditions:</p>
    <ol>
      <li>It is free to use.</li>
      <li>It works in a web browser, with nothing to download or install.</li>
      <li>You can try it without signing up.</li>
    </ol>
    <p>
      {OWN_COUNT} of the {TOOL_COUNT} tools are Rollkey’s own projects, most of them on oumashu.top subdomains such as
      imghub.oumashu.top. The other {THIRD_PARTY_COUNT} are established third-party sites; their cards are marked
      “3rd Party” and they follow their own terms and privacy policies. Each entry is checked when it is added or
      changed, and the date of that change is recorded.
    </p>

    <h2 id="what-is-listed">What is on OumaShu?</h2>
    <div class="about__table">
      <table>
        <thead>
          <tr><th scope="col">Line</th><th scope="col">Tools</th><th scope="col">Examples</th></tr>
        </thead>
        <tbody>
          {lines.map((line) => (
            <tr>
              <th scope="row">
                <a href={`/categories/${line.id}/`} style={`--c:${line.meta.color}`}>
                  <span class="about__code mono">{line.meta.code}</span>{categorySeo('en', line.id, line.name).h1}
                </a>
              </th>
              <td class="mono">{line.stations.length}</td>
              <td>{line.stations.slice(0, 3).map((s) => t[s.tool.id] ?? s.tool.name).join(', ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id="who-makes-it">Who makes OumaShu?</h2>
    <div class="about__author">
      <img src="/admin_img.jpg" alt="Rollkey, creator of OumaShu" width="96" height="96" loading="lazy" decoding="async" />
      <div>
        <p>
          OumaShu is built and maintained by <strong>Rollkey</strong>, an independent developer. Rollkey designs and
          codes most of the tools listed here, from the image tools on imghub.oumashu.top to the Yifang board-game
          tutorials, and writes the directory itself.
        </p>
        <p>
          X (Twitter): <a href="https://x.com/Rollkey4" target="_blank" rel="noopener me">@Rollkey4</a>{' · '}Email: <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </p>
      </div>
    </div>

    <h2 id="funding">How is OumaShu funded?</h2>
    <p>
      OumaShu is free and has no paid plan. It is paid for by Google AdSense ads. How ads and cookies work, and how
      to opt out of personalized ads, is explained in the <a href="/privacy/">Privacy Policy</a>.
    </p>

    <h2 id="languages">Which languages is it in?</h2>
    <p>Every page of the directory is available in six languages, each at its own address:</p>
    <ul class="about__langs">
      {LOCALES.map((l) => (
        <li><a href={localePath(l.id, '/')} hreflang={l.hreflang[0]} lang={l.id}>{l.label}</a> <span class="mono">{`oumashu.top${localePath(l.id, '/')}`}</span></li>
      ))}
    </ul>

    <h2 id="contact">Suggest a tool or report a problem</h2>
    <p>
      Know a free browser tool that belongs here, or found a broken link? Email
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a> or message
      <a href="https://x.com/Rollkey4" target="_blank" rel="noopener">@Rollkey4</a> on X.
    </p>
  </main>
  <SiteFooter />
</Base>

<style>
  .about {
    max-width: 820px;
    margin: 0 auto;
    padding: 40px 24px 88px;
    font-size: 17px;
    line-height: 1.7;
  }
  .about h1 {
    margin: 48px 0 0;
    font-size: clamp(2rem, 1.4rem + 2vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .about__date {
    margin: 8px 0 24px;
    font-size: 13px;
    color: var(--color-muted);
  }
  .about__lead {
    font-size: 19px;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .about__facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 28px 0 8px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-border);
  }
  .about__facts div {
    padding: 14px 16px;
    background: var(--color-card);
  }
  .about__facts dt {
    font-size: 13px;
    color: var(--color-muted);
  }
  .about__facts dd {
    margin: 2px 0 0;
    font: 800 28px/1.1 var(--font-sans);
    font-variant-numeric: tabular-nums;
  }
  .about h2 {
    margin: 44px 0 10px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .about p,
  .about ol,
  .about ul {
    margin: 0 0 14px;
  }
  .about ol {
    padding-left: 22px;
    list-style: decimal;
  }
  .about p a,
  .about li a {
    color: var(--color-brand-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .about__table {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }
  .about table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .about th,
  .about td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }
  .about tbody tr:last-child > * {
    border-bottom: 0;
  }
  .about thead th {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-muted);
    background: var(--color-panel);
  }
  .about tbody th {
    font-weight: 700;
    white-space: nowrap;
  }
  .about tbody th a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }
  .about tbody th a:hover {
    text-decoration: underline;
  }
  .about__code {
    padding: 2px 4px 1px;
    border: 2px solid var(--c);
    border-radius: 5px;
    background: #fff;
    color: #18181b;
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1;
  }
  .about td {
    color: var(--color-muted);
  }
  .about__author {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .about__author img {
    flex: none;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
  }
  .about__langs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 6px 24px;
    padding: 0;
    list-style: none;
  }
  .about__langs span {
    font-size: 12.5px;
    color: var(--color-muted);
  }
  @media (max-width: 640px) {
    .about__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about__author {
      flex-direction: column;
    }
    .about tbody th {
      white-space: normal;
    }
  }
</style>

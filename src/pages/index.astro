---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import { tools } from '../data/tools';
import { getLines, hostOf } from '../data/lines';
import en from '../locales/en.json';

const t: Record<string, any> = en;
const lines = getLines();
const shotIds = new Set(
  tools
    .filter((tool) => fs.existsSync(path.join(process.cwd(), 'public', 'shots', `${tool.id}.webp`)))
    .map((tool) => tool.id)
);
const fill = (tpl: string, vals: Record<string, string | number>) =>
  tpl.replace(/\{\{(\w+)\}\}/g, (_, k) => String(vals[k] ?? ''));
const year = new Date().getFullYear();

const LOCALES = [
  { id: 'en', label: 'English', short: 'EN' },
  { id: 'zh-CN', label: '简体中文', short: '简' },
  { id: 'zh-TW', label: '繁體中文', short: '繁' },
  { id: 'ja-JP', label: '日本語', short: '日' },
  { id: 'ar', label: 'العربية', short: 'ع' },
  { id: 'ru', label: 'Русский', short: 'RU' },
];
---

<Base
  title="OumaShu - Tools Directory | All-in-One Productivity Hub"
  description="Curated tools directory to boost your productivity. Browse by category for free online tools including video, audio, text, image converters, and more."
  keywords="tools, productivity, online tools, free tools, utilities, web apps, screen recorder, chat, converter, directory"
>
  <!-- 站牌頂欄 -->
  <header class="topbar">
    <div class="topbar__inner">
      <a class="brand" href="/" aria-label="OumaShu">
        <span class="badge" style="--c: var(--color-brand)"><span>OS</span></span>
        <span class="brand__name">OumaShu<span class="brand__ja" lang="ja">櫻滿集</span></span>
      </a>

      <div class="search" role="search">
        <svg class="search__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
        <label class="sr-only" for="search-input">{t.nav.search}</label>
        <input id="search-input" type="search" autocomplete="off" spellcheck="false" placeholder={t.search_placeholder} />
        <kbd class="search__kbd" aria-hidden="true" id="search-kbd">/</kbd>
      </div>

      <div class="status">
        <span class="status__item" id="location-text"></span>
        <span class="status__item mono" id="time-text">--:--</span>
        <span class="status__item" id="weather-info">
          <svg class="wx" data-wx="clear" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.5M12 19v2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M2.5 12H5M19 12h2.5M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" /></svg>
          <svg class="wx" data-wx="cloud" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M7 18h10a4 4 0 0 0 .6-7.96A6 6 0 0 0 6.1 11 3.5 3.5 0 0 0 7 18Z" /></svg>
          <svg class="wx" data-wx="rain" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M7 15h10a4 4 0 0 0 .6-7.96A6 6 0 0 0 6.1 8 3.5 3.5 0 0 0 7 15ZM9 18l-1 2.5M13 18l-1 2.5M17 18l-1 2.5" /></svg>
          <svg class="wx" data-wx="snow" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M7 14h10a4 4 0 0 0 .6-7.96A6 6 0 0 0 6.1 7 3.5 3.5 0 0 0 7 14ZM8 18h.01M12 19h.01M16 18h.01M10 21h.01M14 21h.01" /></svg>
          <svg class="wx" data-wx="storm" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M7 14h10a4 4 0 0 0 .6-7.96A6 6 0 0 0 6.1 7 3.5 3.5 0 0 0 7 14ZM13 15l-2.5 3.5H14L11.5 22" /></svg>
          <svg class="wx" data-wx="fog" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M4 9h16M6 13h12M4 17h16" /></svg>
          <span class="mono" id="weather-text">--°</span>
        </span>
      </div>

      <div class="controls">
        <div class="lang">
          <button id="language-toggle-btn" class="ctrl" type="button" aria-haspopup="true" aria-expanded="false" aria-label={t.language_label}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M3.5 12h17M12 3.5c2.4 2.4 3.6 5.2 3.6 8.5s-1.2 6.1-3.6 8.5c-2.4-2.4-3.6-5.2-3.6-8.5S9.6 5.9 12 3.5Z" /></svg>
            <span id="language-code">EN</span>
          </button>
          <ul id="language-dropdown" class="lang__menu" hidden>
            {LOCALES.map((loc) => (
              <li>
                <button type="button" class="language-option" data-locale={loc.id} data-short={loc.short} lang={loc.id}>
                  {loc.label}
                  <svg class="lang__check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                </button>
              </li>
            ))}
          </ul>
        </div>
        <button id="theme-toggle-btn" class="ctrl" type="button" data-mode="system" aria-label={t.theme_label}>
          <svg class="i-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.5M12 19v2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M2.5 12H5M19 12h2.5M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" /></svg>
          <svg class="i-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10Z" /></svg>
          <svg class="i-system" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="12" rx="1.5" /><path d="M9 20h6M12 16.5V20" /></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main-content">
    <!-- 駅名標 + 標題 -->
    <section class="hero">
      <div class="hero__copy">
        <h1 id="hero-title">{t.hero_title}</h1>
        <p id="hero-sub" data-tpl-tools={tools.length} data-tpl-lines={lines.length}>
          {fill(t.hero_sub, { tools: tools.length, lines: lines.length })}
        </p>
        <ul class="facts">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg><span id="intro-feature-free-title">{t.intro_feature_free_title}</span></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="9.5" rx="2" /><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" /></svg><span id="intro-feature-privacy-title">{t.intro_feature_privacy_title}</span></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3 5.5 13.5H12L11 21l7.5-10.5H12L13 3Z" /></svg><span id="intro-feature-noinstall-title">{t.intro_feature_noinstall_title}</span></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.5" /><path d="M5.5 19.5a6.5 6.5 0 0 1 13 0M4 4l16 16" /></svg><span id="fact-nosignup">{t.fact_nosignup}</span></li>
        </ul>
      </div>

      <div class="ekimei">
        <div class="ekimei__top">
          <span class="badge badge--lg" style="--c: var(--color-brand)" aria-hidden="true"><span>OS<br />00</span></span>
          <div class="ekimei__name" aria-hidden="true">
            <span class="ekimei__kanji" lang="ja">櫻滿集</span>
            <span class="ekimei__roman">Ōmashū</span>
          </div>
        </div>
        <nav class="ekimei__band" aria-label={t.map_label}>
          <a href={`#line-${lines[0].id}`} class="ekimei__next" style={`--c:${lines[0].meta.color}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7" /></svg>
            <span class="mono">{lines[0].meta.code}</span>
            <span data-cat={lines[0].id}>{t.categories[lines[0].id] ?? lines[0].name}</span>
          </a>
          <a href={`#line-${lines[lines.length - 1].id}`} class="ekimei__next ekimei__next--r" style={`--c:${lines[lines.length - 1].meta.color}`}>
            <span data-cat={lines[lines.length - 1].id}>{t.categories[lines[lines.length - 1].id] ?? lines[lines.length - 1].name}</span>
            <span class="mono">{lines[lines.length - 1].meta.code}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
          </a>
        </nav>
      </div>
    </section>

    <!-- 線路圖 -->
    <section class="map" aria-labelledby="map-title">
      <h2 id="map-title" class="sr-only">{t.map_label}</h2>
      <ol class="map__lines">
        {lines.map((line, i) => (
          <li class:list={['mline', { 'mline--wide': line.stations.length > 3 }]} data-line={line.id} style={`--c:${line.meta.color};--n:${line.stations.length};--i:${i}`}>
            <button type="button" class="mline__label" data-filter={line.id} aria-pressed="false">
              <span class="badge"><span>{line.meta.code}</span></span>
              <span class="mline__name">
                <span data-cat={line.id}>{t.categories[line.id] ?? line.name}</span>
                <span class="ja" lang="ja">{line.meta.ja}</span>
              </span>
            </button>
            <ol class="mline__track">
              {line.stations.map((s) => (
                <li>
                  <a class="stn" href={`#tool-${s.tool.id}`} data-station={s.tool.id}>
                    <span class="stn__dot"></span>
                    <span class="stn__name" data-i18n-tool={s.tool.id}>{t[s.tool.id] ?? s.tool.name}</span>
                    <span class="stn__code mono">{s.code}</span>
                  </a>
                </li>
              ))}
            </ol>
          </li>
        ))}
      </ol>
    </section>

    <!-- 線路篩選 -->
    <nav class="rail" aria-label={t.map_label}>
      <div class="rail__inner">
        <div class="rail__chips">
          <button type="button" class="chip is-on" data-filter="all" aria-pressed="true">
            <span id="all-lines-label">{t.all_lines}</span><span class="chip__n mono">{tools.length}</span>
          </button>
          {lines.map((line) => (
            <button type="button" class="chip" data-filter={line.id} aria-pressed="false" style={`--c:${line.meta.color}`}>
              <span class="chip__code mono">{line.meta.code}</span>
              <span data-cat={line.id}>{t.categories[line.id] ?? line.name}</span>
              <span class="chip__n mono">{line.stations.length}</span>
            </button>
          ))}
        </div>
      </div>
    </nav>

    <!-- 各線路的站 -->
    <div class="dir" id="directory">
      <p id="search-status" class="dir__status" aria-live="polite"></p>
      {lines.map((line) => (
        <section class="dline" data-line={line.id} id={`line-${line.id}`} style={`--c:${line.meta.color}`} aria-labelledby={`line-title-${line.id}`}>
          <header class="dline__head">
            <span class="badge badge--lg"><span>{line.meta.code}</span></span>
            <h2 id={`line-title-${line.id}`}>
              <span data-cat={line.id}>{t.categories[line.id] ?? line.name}</span>
              <span class="ja" lang="ja">{line.meta.ja}</span>
            </h2>
            <span class="dline__count mono" data-count={line.stations.length}>
              {fill(t.stations_count, { count: line.stations.length })}
            </span>
          </header>
          <div class="dline__grid">
            {line.stations.map((s) => (
              <article class="tcard" id={`tool-${s.tool.id}`} data-tool-id={s.tool.id} data-line={line.id}>
                <a class="tcard__link" href={s.tool.url} target="_blank" rel="noopener noreferrer">
                  <div class="tcard__shot">
                    {shotIds.has(s.tool.id) ? (
                      <img src={`/shots/${s.tool.id}.webp`} alt="" width="960" height="600" loading="lazy" decoding="async" />
                    ) : (
                      <div class="tcard__plate"><span>{t[s.tool.id] ?? s.tool.name}</span></div>
                    )}
                  </div>
                  <div class="tcard__body">
                    <div class="tcard__title">
                      <span class="badge tcard__code"><span>{s.code.replace(' ', ' ')}</span></span>
                      <h3 class="tcard__name" data-i18n-tool={s.tool.id}>{t[s.tool.id] ?? s.tool.name}</h3>
                    </div>
                    <p class="tcard__desc" data-i18n-desc={s.tool.id}>{t[`${s.tool.id}_desc`] ?? s.tool.description}</p>
                    <div class="tcard__meta">
                      <span class="tcard__host mono">{hostOf(s.tool.url)}</span>
                      {s.tool.thirdParty && <span class="tcard__tag third-party-text">{t.third_party}</span>}
                      <span class="tcard__open">
                        <span class="open-label">{t.open_tool}</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
                      </span>
                    </div>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </section>
      ))}

      <div id="empty-state" class="empty" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5M8.5 11h5" /></svg>
        <p id="empty-text">{t.search_no_results}</p>
        <button type="button" id="clear-search" class="empty__btn">{t.clear_search}</button>
      </div>
    </div>
  </main>

  <!-- 終點站 -->
  <footer class="foot">
    <div class="foot__stripe" aria-hidden="true">
      {lines.map((line) => <i style={`--c:${line.meta.color}`}></i>)}
    </div>
    <div class="foot__inner">
      <div class="foot__about">
        <a class="brand" href="/" aria-label="OumaShu">
          <span class="badge" style="--c: var(--color-brand)"><span>OS</span></span>
          <span class="brand__name">OumaShu<span class="brand__ja" lang="ja">櫻滿集</span></span>
        </a>
        <h2 id="footer-about-title">{t.footer_about_title}</h2>
        <p id="intro-paragraph">{t.intro_paragraph}</p>
      </div>
      <nav class="foot__col" aria-label="OumaShu">
        <a href="/about" id="foot-about">{t.footer.about}</a>
        <a href="/privacy" id="foot-privacy">{t.footer.privacy}</a>
      </nav>
      <div class="foot__col">
        <span class="foot__label" id="foot-contact">{t.footer.contact}</span>
        <a href="mailto:wanghongxiang23@gmail.com">wanghongxiang23@gmail.com</a>
        <a href="https://x.com/Rollkey4" target="_blank" rel="noopener noreferrer">@Rollkey4 on X</a>
      </div>
    </div>
    <div class="foot__base mono">© {year} OumaShu · oumashu.top</div>
  </footer>
</Base>

<script>
  import { tools } from '../data/tools';
  import en from '../locales/en.json';
  import zhCN from '../locales/zh-CN.json';
  import zhTW from '../locales/zh-TW.json';
  import jaJP from '../locales/ja-JP.json';
  import ar from '../locales/ar.json';
  import ru from '../locales/ru.json';

  type Dict = Record<string, any>;
  const translations: Record<string, Dict> = { en, 'zh-CN': zhCN, 'zh-TW': zhTW, 'ja-JP': jaJP, ar, ru };
  const tr = (locale: string): Dict => translations[locale] || en;
  const fill = (tpl: string, vals: Record<string, string | number>) =>
    tpl.replace(/\{\{(\w+)\}\}/g, (_, k) => String(vals[k] ?? ''));
  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel);
  const $$ = <T extends Element = HTMLElement>(sel: string) => Array.from(document.querySelectorAll<T>(sel));

  const toolById = new Map(tools.map((tool) => [tool.id, tool]));
  const cards = $$<HTMLElement>('.tcard');
  const sections = $$<HTMLElement>('.dline');
  const stations = $$<HTMLAnchorElement>('.stn');
  const mapLines = $$<HTMLElement>('.mline');
  const filterButtons = $$<HTMLButtonElement>('[data-filter]');
  const searchInput = $<HTMLInputElement>('#search-input')!;
  const searchStatus = $('#search-status')!;
  const emptyState = $('#empty-state')!;

  let locale = 'en';
  let filter = 'all';
  let query = '';

  // 一次 IP 查詢，語言與天氣共用
  const geo: Promise<Dict | null> = fetch('https://ipapi.co/json/')
    .then((r) => (r.ok ? r.json() : null))
    .catch(() => null);

  // ---------- 搜索索引（所有語言的名稱與說明 + 標籤）----------
  const haystack = new Map<string, string>();
  for (const tool of tools) {
    const parts = [tool.name, tool.description, ...(tool.tags || [])];
    for (const dict of Object.values(translations)) {
      if (dict[tool.id]) parts.push(dict[tool.id]);
      if (dict[`${tool.id}_desc`]) parts.push(dict[`${tool.id}_desc`]);
      if (dict.categories?.[tool.category || '']) parts.push(dict.categories[tool.category || '']);
    }
    haystack.set(tool.id, parts.join(' ').toLowerCase());
  }

  // ---------- 篩選 / 搜索 ----------
  function apply() {
    const t = tr(locale);
    const q = query.trim().toLowerCase();
    let shown = 0;
    const visible = new Set<string>();

    for (const card of cards) {
      const id = card.dataset.toolId!;
      const lineOk = filter === 'all' || card.dataset.line === filter;
      const queryOk = !q || (haystack.get(id) || '').includes(q);
      const on = lineOk && queryOk;
      card.hidden = !on;
      if (on) {
        shown++;
        visible.add(id);
      }
    }
    for (const section of sections) {
      section.hidden = !section.querySelector('.tcard:not([hidden])');
    }
    for (const stn of stations) {
      stn.classList.toggle('is-dim', !visible.has(stn.dataset.station!));
    }
    for (const line of mapLines) {
      line.classList.toggle('is-dim', !line.querySelector('.stn:not(.is-dim)'));
    }
    for (const btn of filterButtons) {
      const on = btn.dataset.filter === filter;
      btn.classList.toggle('is-on', on);
      btn.setAttribute('aria-pressed', String(on));
    }

    emptyState.hidden = shown > 0;
    searchStatus.textContent = q && shown > 0
      ? shown === 1 && t.search_results_found_one
        ? t.search_results_found_one
        : fill(t.search_results_found || 'Found {{count}} tools', { count: shown })
      : '';
  }

  function setFilter(next: string) {
    filter = next;
    apply();
  }

  let searchTimer: number | undefined;
  searchInput.addEventListener('input', () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      query = searchInput.value;
      apply();
    }, 120);
  });
  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      searchInput.value = '';
      query = '';
      apply();
      searchInput.blur();
    }
  });
  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    const typing = target.closest('input, textarea, select, [contenteditable="true"]');
    if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey && !e.altKey) {
      e.preventDefault();
      searchInput.focus();
      searchInput.select();
    }
  });

  $('#clear-search')!.addEventListener('click', () => {
    searchInput.value = '';
    query = '';
    filter = 'all';
    apply();
    searchInput.focus();
  });

  for (const btn of filterButtons) {
    btn.addEventListener('click', () => {
      const id = btn.dataset.filter!;
      const next = id === filter && id !== 'all' ? 'all' : id;
      setFilter(next);
      // 從線路圖點擊時，乘車到目錄
      if (btn.classList.contains('mline__label')) {
        document.getElementById('directory')?.scrollIntoView({ block: 'start' });
      }
    });
  }

  // ---------- 站點 ↔ 卡片 ----------
  for (const stn of stations) {
    stn.addEventListener('click', (e) => {
      const id = stn.dataset.station!;
      const card = document.getElementById(`tool-${id}`);
      if (!card) return;
      e.preventDefault();
      if (card.hidden) {
        filter = 'all';
        query = '';
        searchInput.value = '';
        apply();
      }
      card.scrollIntoView({ block: 'center' });
      card.classList.remove('is-arrive');
      void card.offsetWidth;
      card.classList.add('is-arrive');
      card.querySelector<HTMLAnchorElement>('.tcard__link')?.focus({ preventScroll: true });
    });
  }
  for (const card of cards) {
    const stn = document.querySelector(`.stn[data-station="${card.dataset.toolId}"]`);
    const on = () => stn?.classList.add('is-hover');
    const off = () => stn?.classList.remove('is-hover');
    card.addEventListener('pointerenter', on);
    card.addEventListener('pointerleave', off);
    card.addEventListener('focusin', on);
    card.addEventListener('focusout', off);
    card.addEventListener('animationend', () => card.classList.remove('is-arrive'));
  }

  // ---------- 語言 ----------
  const langBtn = $<HTMLButtonElement>('#language-toggle-btn')!;
  const langMenu = $('#language-dropdown')!;
  const langOptions = $$<HTMLButtonElement>('.language-option');

  function setText(sel: string, value?: string) {
    const el = $(sel);
    if (el && value) el.textContent = value;
  }

  function applyLocale(next: string) {
    locale = translations[next] ? next : 'en';
    const t = tr(locale);
    document.documentElement.lang = locale;
    document.documentElement.dir = 'ltr'; // 保持 LTR 版面

    setText('#hero-title', t.hero_title);
    const sub = $('#hero-sub');
    if (sub && t.hero_sub) {
      sub.textContent = fill(t.hero_sub, { tools: sub.dataset.tplTools!, lines: sub.dataset.tplLines! });
    }
    setText('#intro-feature-free-title', t.intro_feature_free_title);
    setText('#intro-feature-privacy-title', t.intro_feature_privacy_title);
    setText('#intro-feature-noinstall-title', t.intro_feature_noinstall_title);
    setText('#fact-nosignup', t.fact_nosignup);
    setText('#intro-paragraph', t.intro_paragraph);
    setText('#footer-about-title', t.footer_about_title);
    setText('#all-lines-label', t.all_lines);
    setText('#empty-text', t.search_no_results);
    setText('#clear-search', t.clear_search);
    setText('#map-title', t.map_label);
    setText('#foot-about', t.footer?.about);
    setText('#foot-privacy', t.footer?.privacy);
    setText('#foot-contact', t.footer?.contact);

    for (const el of $$('[data-cat]')) {
      const name = t.categories?.[el.dataset.cat!];
      if (name) el.textContent = name;
    }
    for (const el of $$('[data-i18n-tool]')) {
      const id = el.dataset.i18nTool!;
      el.textContent = t[id] || en[id as keyof typeof en] || toolById.get(id)?.name || el.textContent;
    }
    for (const el of $$('[data-i18n-desc]')) {
      const id = el.dataset.i18nDesc!;
      el.textContent = t[`${id}_desc`] || toolById.get(id)?.description || el.textContent;
    }
    for (const el of $$('[data-count]')) {
      el.textContent = fill(t.stations_count || '{{count}} stations', { count: el.dataset.count! });
    }
    for (const el of $$('.open-label')) el.textContent = t.open_tool || 'Open';
    for (const el of $$('.third-party-text')) el.textContent = t.third_party || '3rd Party';

    searchInput.placeholder = t.search_placeholder || 'Search tools...';
    searchInput.title = t.search_hint || '';
    langBtn.setAttribute('aria-label', t.language_label || 'Language');
    $('#theme-toggle-btn')!.setAttribute('aria-label', `${t.theme_label || 'Theme'}: ${t.theme?.[themeMode] || themeMode}`);

    for (const opt of langOptions) {
      const on = opt.dataset.locale === locale;
      opt.classList.toggle('is-current', on);
      opt.setAttribute('aria-current', on ? 'true' : 'false');
      if (on) $('#language-code')!.textContent = opt.dataset.short || 'EN';
    }
    apply();
  }

  function closeMenu() {
    langMenu.hidden = true;
    langBtn.setAttribute('aria-expanded', 'false');
  }
  langBtn.addEventListener('click', () => {
    const open = langMenu.hidden;
    langMenu.hidden = !open;
    langBtn.setAttribute('aria-expanded', String(open));
    if (open) langMenu.querySelector<HTMLButtonElement>('.is-current, .language-option')?.focus();
  });
  for (const opt of langOptions) {
    opt.addEventListener('click', () => {
      try { localStorage.setItem('locale', opt.dataset.locale!); } catch {}
      applyLocale(opt.dataset.locale!);
      closeMenu();
      langBtn.focus();
    });
  }
  document.addEventListener('click', (e) => {
    if (!langBtn.contains(e.target as Node) && !langMenu.contains(e.target as Node)) closeMenu();
  });
  langMenu.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMenu();
      langBtn.focus();
    }
  });

  const COUNTRY_LOCALE: Record<string, string> = {
    CN: 'zh-CN', TW: 'zh-TW', HK: 'zh-TW', MO: 'zh-TW', JP: 'ja-JP',
    RU: 'ru', BY: 'ru', KZ: 'ru', KG: 'ru',
    SA: 'ar', AE: 'ar', EG: 'ar', JO: 'ar', LB: 'ar', SY: 'ar', IQ: 'ar', KW: 'ar', QA: 'ar',
    BH: 'ar', OM: 'ar', YE: 'ar', MA: 'ar', TN: 'ar', DZ: 'ar', LY: 'ar', SD: 'ar',
  };

  // ---------- 主題 ----------
  const themeBtn = $<HTMLButtonElement>('#theme-toggle-btn')!;
  let themeMode = 'system';
  try { themeMode = localStorage.getItem('theme') || 'system'; } catch {}
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  function applyTheme(mode: string) {
    themeMode = mode;
    const actual = mode === 'system' ? (media.matches ? 'dark' : 'light') : mode;
    document.documentElement.setAttribute('data-theme', actual);
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', actual === 'dark' ? '#0d172c' : '#14223f');
    themeBtn.dataset.mode = mode;
    const t = tr(locale);
    themeBtn.setAttribute('aria-label', `${t.theme_label || 'Theme'}: ${t.theme?.[mode] || mode}`);
  }
  themeBtn.addEventListener('click', () => {
    const order = ['light', 'dark', 'system'];
    const next = order[(order.indexOf(themeMode) + 1) % order.length];
    try { localStorage.setItem('theme', next); } catch {}
    applyTheme(next);
  });
  media.addEventListener('change', () => themeMode === 'system' && applyTheme('system'));
  applyTheme(themeMode);

  // ---------- 時間 / 地點 / 天氣 ----------
  const timeText = $('#time-text')!;
  function tick() {
    const now = new Date();
    timeText.textContent = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
  }
  tick();
  window.setInterval(tick, 30000);

  function weatherKind(code: number) {
    if (code <= 1) return 'clear';
    if (code <= 3) return 'cloud';
    if (code === 45 || code === 48) return 'fog';
    if ((code >= 71 && code <= 77) || code === 85 || code === 86) return 'snow';
    if (code >= 95) return 'storm';
    return 'rain';
  }

  async function loadWeather() {
    const data = await geo;
    if (!data) return;
    if (data.city) $('#location-text')!.textContent = `${data.city}, ${data.country_code}`;
    if (data.latitude == null || data.longitude == null) return;
    try {
      const res = await fetch(
        `https://api.open-meteo.com/v1/forecast?latitude=${data.latitude}&longitude=${data.longitude}&current_weather=true&timezone=auto`
      );
      const w = (await res.json()).current_weather;
      if (!w) return;
      $('#weather-text')!.textContent = `${Math.round(w.temperature)}°C`;
      const kind = weatherKind(w.weathercode);
      for (const icon of $$<SVGElement>('.wx')) {
        if (icon.dataset.wx === kind) icon.removeAttribute('hidden');
        else icon.setAttribute('hidden', '');
      }
    } catch {}
  }
  loadWeather();
  window.setInterval(loadWeather, 1800000);

  // ---------- 初始化語言 ----------
  let saved: string | null = null;
  try { saved = localStorage.getItem('locale'); } catch {}
  applyLocale(saved || 'en');
  if (!saved) {
    geo.then((data) => {
      const detected = data?.country_code ? COUNTRY_LOCALE[data.country_code] : undefined;
      if (detected && detected !== locale) applyLocale(detected);
    });
  }
</script>

